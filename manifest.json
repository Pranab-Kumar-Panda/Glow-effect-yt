{
  "manifest_version": 3,
  "name": "Reel Glow",
  "version": "1.2.1",
  "description": "Fills the black side bars of Instagram Reels and YouTube Shorts with a live glow that matches the video's colors. Click the icon to customize.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Reel Glow: click to customize",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}